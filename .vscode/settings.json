{
    "java.import.exclusions": [
        "**/node_modules/**",
        "**/android/build/**",
        "**/.gradle/**"
    ],
    "gradle.nestedProjects": false,
    "gradle.autoDetect": "off",
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/.gradle/**": true,
        "**/android/build/**": true
    },
    "files.exclude": {
        "**/node_modules": true
    }
}
